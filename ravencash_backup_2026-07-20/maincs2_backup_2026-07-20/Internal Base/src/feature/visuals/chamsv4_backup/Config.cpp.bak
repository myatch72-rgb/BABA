      continue;
    }
    if (key == "sc_fix_skin_count") {
      int count = 0;
      in >> count;
      if (count < 0) {
        parseFailed = true;
        break;
      }
      Globals::sc_fix_skin_weapons.clear();
      continue;
    }
    if (key == "sc_fix_skin") {
      int weaponDefinition = 0;
      in >> weaponDefinition;
      if (weaponDefinition > 0)
        Globals::sc_fix_skin_weapons.insert(weaponDefinition);
      continue;
    }
    if (key == "sc_skin_count") {
      int count;
      in >> count;
      if (g_SkinManager)
        g_SkinManager->Skins.clear();
      continue;
    }
    if (key == "sc_skin") {
      int wepId, paintKit;
      in >> wepId >> paintKit;
      if (paintKit > 0 && g_SkinManager) {
        SkinInfo_t skin;
        skin.paintKit = paintKit;
        skin.weaponType = static_cast<WeaponsEnum>(wepId);
        skin.wear = 0.001f;
        g_SkinManager->AddSkin(skin);
      }
      continue;
    }
    if (key == "sc_glove_def") {
      uint16_t def;
      in >> def;
      if (g_SkinManager)
        g_SkinManager->Gloves.defIndex = def;
      continue;
    }
    if (key == "sc_glove_paint") {
      int paint;
      in >> paint;
      if (g_SkinManager)
        g_SkinManager->Gloves.paintKit = paint;
      continue;
    }
    if (key == "sc_music_kit_id") {
      uint16_t id;
      in >> id;
      if (g_SkinManager)
        g_SkinManager->MusicKit.id = id;
      continue;
    }

    if (key == "sc_selected_knife_skin") {
      int tmp;
      in >> tmp;
      continue;
    }
    if (key == "sc_selected_glove_skin") {
      in >> Globals::sc_selected_glove_skin;
      continue;
    }
    if (key == "sc_weapon_skin_count") {
      int tmp;
      in >> tmp;
      continue;
    }
    if (key == "sc_weapon_skin") {
      int a, b;
      in >> a >> b;
      continue;
    }

    {
      std::string discard;
      std::getline(in, discard);
    }
  }

  if (parseFailed || in.bad()) {
    restoreSkinState();
    in.close();
    last_status = "Load failed: malformed value near key '" + lastKey + "'";
    return;
  }

  // IDs are the durable representation. Rebuild the complete UI/runtime
  // records so names and combo selections cannot remain stale after a load.
  if (g_SkinManager->Gloves.defIndex != 0) {
    const auto glove = std::find_if(
        GloveTypes.begin(), GloveTypes.end(), [&](const Glove_t &candidate) {
          return candidate.defIndex == g_SkinManager->Gloves.defIndex;
        });
    if (glove != GloveTypes.end()) {
      g_SkinManager->Gloves.name = glove->name;
      Globals::sc_selected_glove_type =
          static_cast<int>(std::distance(GloveTypes.begin(), glove));
    } else {
      g_SkinManager->Gloves.name.clear();
      Globals::sc_selected_glove_type = -1;
    }
  } else if (Globals::sc_selected_glove_type >= 0 &&
             Globals::sc_selected_glove_type <
                 static_cast<int>(GloveTypes.size())) {
    const auto &glove = GloveTypes[Globals::sc_selected_glove_type];
    g_SkinManager->Gloves.defIndex = glove.defIndex;
    g_SkinManager->Gloves.name = glove.name;
  } else {
    g_SkinManager->Gloves = Glove_t{};
    Globals::sc_selected_glove_type = -1;
    Globals::sc_selected_glove_skin = -1;
  }

  const auto musicKit = std::find_if(
      MusicKits.begin(), MusicKits.end(), [&](const MusicKitInfo_t &candidate) {
        return candidate.id == g_SkinManager->MusicKit.id;
      });
  if (musicKit != MusicKits.end()) {
    g_SkinManager->MusicKit = *musicKit;
    Globals::sc_selected_music_kit =
        static_cast<int>(std::distance(MusicKits.begin(), musicKit));
  } else if (Globals::sc_selected_music_kit >= 0 &&
             Globals::sc_selected_music_kit <
                 static_cast<int>(MusicKits.size())) {
    g_SkinManager->MusicKit = MusicKits[Globals::sc_selected_music_kit];
  } else {
    g_SkinManager->MusicKit = MusicKits.front();
    Globals::sc_selected_music_kit = 0;
  }

  Globals::sc_force_update = 3;
  in.close();
  current_config = name;
  last_status = "Loaded " +
                std::string(schemaWasPresent
                                ? ("schema v" +
                                   std::to_string(loadedSchemaVersion))
                                : "legacy schema v1") +
                ": " + name;
}

void Delete(std::string name) {
  name = NormalizeConfigName(std::move(name));
  if (name.empty()) {
    last_status = "Delete failed: invalid profile name";
    return;
  }

  std::filesystem::path path = GetConfigPath() / name;
  if (std::filesystem::exists(path)) {
    std::filesystem::remove(path);
    if (current_config == name)
      current_config.clear();
    last_status = "Deleted: " + name;
    Refresh();
  } else {
    last_status = "Delete failed: profile not found";
  }
}

void Refresh() {
  configs.clear();
  std::filesystem::path path = GetConfigPath();
  if (std::filesystem::exists(path)) {
    for (const auto &entry : std::filesystem::directory_iterator(path)) {
      if (entry.path().extension() == ".txt") {
        configs.push_back(entry.path().filename().string());
      }
    }
  }
  std::sort(configs.begin(), configs.end());
}
} // namespace Config
