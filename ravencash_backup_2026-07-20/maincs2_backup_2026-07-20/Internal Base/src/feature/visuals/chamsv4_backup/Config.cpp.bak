      << Globals::grenade_prediction_show_text << "\n";
  out << "grenade_prediction_always_show "
      << Globals::grenade_prediction_always_show << "\n";
  out << "grenade_prediction_passive_strength "
      << Globals::grenade_prediction_passive_strength << "\n";

  out << "aspect_ratio_enabled " << Globals::aspect_ratio_enabled << "\n";
  out << "aspect_ratio_value "   << Globals::aspect_ratio_value   << "\n";

  out << "particle_color_enabled " << Globals::particle_color_enabled << "\n";
  out << "particle_color_style " << Globals::particle_color_style << "\n";
  out << "particle_color "
      << Globals::particle_color[0] << " "
      << Globals::particle_color[1] << " "
      << Globals::particle_color[2] << " "
      << Globals::particle_color[3] << "\n";

  out << "ragdoll_nograv_enabled " << Globals::ragdoll_nograv_enabled << "\n";
  out << "ragdoll_nograv_scale "   << Globals::ragdoll_nograv_scale   << "\n";
  out << "skip_team_intro "        << Globals::skip_team_intro        << "\n";

  out << "sc_enabled " << Globals::sc_enabled << "\n";
  out << "sc_selected_knife " << Globals::sc_selected_knife << "\n";
  out << "sc_selected_glove_type " << Globals::sc_selected_glove_type << "\n";
  out << "sc_selected_glove_skin " << Globals::sc_selected_glove_skin << "\n";
  out << "sc_selected_music_kit " << Globals::sc_selected_music_kit << "\n";
  out << "sc_selected_agent_ct " << Globals::sc_selected_agent_ct << "\n";
  out << "sc_selected_agent_t " << Globals::sc_selected_agent_t << "\n";

  out << "sc_fix_skin_count " << Globals::sc_fix_skin_weapons.size() << "\n";
  for (const int weaponDefinition : Globals::sc_fix_skin_weapons)
    out << "sc_fix_skin " << weaponDefinition << "\n";

  out << "sc_skin_count " << g_SkinManager->Skins.size() << "\n";
  for (const auto &skin : g_SkinManager->Skins) {
    out << "sc_skin " << (int)skin.weaponType << " " << skin.paintKit << "\n";
  }
  out << "sc_glove_def " << g_SkinManager->Gloves.defIndex << "\n";
  out << "sc_glove_paint " << g_SkinManager->Gloves.paintKit << "\n";
  out << "sc_music_kit_id " << g_SkinManager->MusicKit.id << "\n";

  out.flush();
  const bool writeSucceeded = out.good();
  out.close();
  if (!writeSucceeded || out.fail()) {
    RemoveTemporaryFile(temporaryPath);
    last_status = "Save failed while writing to disk";
    return;
  }

  DWORD commitError = ERROR_SUCCESS;
  if (!CommitTemporaryFile(temporaryPath, path, commitError)) {
    RemoveTemporaryFile(temporaryPath);
    last_status = "Save failed while replacing profile (Win32 error " +
                  std::to_string(commitError) + ")";
    return;
  }

  current_config = name;
  last_status = "Saved schema v" + std::to_string(schema_version) + ": " + name;
  Refresh();
}

void Load(std::string name) {
  name = NormalizeConfigName(std::move(name));
  if (name.empty()) {
    last_status = "Load failed: invalid profile name";
    return;
  }

  if (!g_SkinManager) {
    last_status = "Load failed: SkinManager is not initialized";
    return;
  }
  std::lock_guard<std::recursive_mutex> skinStateLock(g_SkinStateMutex);

  const std::filesystem::path configDirectory = GetConfigPath();
  if (configDirectory.empty()) {
    last_status = "Load failed: config folder is unavailable";
    return;
  }

  const std::filesystem::path path = configDirectory / name;
  std::ifstream in(path);

  if (!in.is_open()) {
    last_status = "Load failed: profile not found";
    return;
  }

  const auto previousSkins = g_SkinManager->Skins;
  const Glove_t previousGloves = g_SkinManager->Gloves;
  const MusicKitInfo_t previousMusicKit = g_SkinManager->MusicKit;
  const int previousKnife = Globals::sc_selected_knife;
  const int previousGloveType = Globals::sc_selected_glove_type;
  const int previousGloveSkin = Globals::sc_selected_glove_skin;
  const int previousMusicKitIndex = Globals::sc_selected_music_kit;
  const int previousAgentCT = Globals::sc_selected_agent_ct;
  const int previousAgentT = Globals::sc_selected_agent_t;
  const auto previousFixedSkins = Globals::sc_fix_skin_weapons;

  const auto restoreSkinState = [&]() {
    g_SkinManager->Skins = previousSkins;
    g_SkinManager->Gloves = previousGloves;
    g_SkinManager->MusicKit = previousMusicKit;
    Globals::sc_selected_knife = previousKnife;
    Globals::sc_selected_glove_type = previousGloveType;
    Globals::sc_selected_glove_skin = previousGloveSkin;
    Globals::sc_selected_music_kit = previousMusicKitIndex;
    Globals::sc_selected_agent_ct = previousAgentCT;
    Globals::sc_selected_agent_t = previousAgentT;
    Globals::sc_fix_skin_weapons = previousFixedSkins;
  };

  // A profile is a complete loadout snapshot. Starting from known defaults
  // also makes older profiles deterministic when newer skin keys are absent.
  g_SkinManager->Skins.clear();
  g_SkinManager->Gloves = Glove_t{};
  g_SkinManager->MusicKit = MusicKits.front();
  Globals::sc_selected_knife = 0;
  Globals::sc_selected_glove_type = -1;
  Globals::sc_selected_glove_skin = -1;
  Globals::sc_selected_music_kit = 0;
  Globals::sc_selected_agent_ct = -1;
  Globals::sc_selected_agent_t = -1;
  Globals::sc_fix_skin_weapons.clear();

  Globals::aim_vis_check = true;
  int loadedSchemaVersion = 1;
  bool schemaWasPresent = false;
  bool parseFailed = false;
  std::string key;
  std::string lastKey;
  for (;;) {
    // A value extraction in the previous branch may have failed. Check it
    // before consuming whitespace so a truncated final line is not mistaken
    // for a clean EOF.
    if (in.fail()) {
      parseFailed = true;
      break;
    }

    in >> std::ws;
    if (in.eof())
      break;
    if (!(in >> key)) {
      parseFailed = true;
      break;
    }
    lastKey = key;

    if (key == "schema_version") {
      in >> loadedSchemaVersion;
      schemaWasPresent = true;
      if (!in || loadedSchemaVersion < 1) {
        parseFailed = true;
        break;
      }
      if (loadedSchemaVersion > schema_version) {
        restoreSkinState();
        in.close();
        last_status = "Load failed: profile schema v" +
                      std::to_string(loadedSchemaVersion) +
                      " is newer than supported v" +
                      std::to_string(schema_version);
        return;
      }
      continue;
    }

    if (key == "esp_enabled_team") {
      in >> Globals::esp_enabled_team;
      continue;
    }
    if (key == "esp_box_team") {
      in >> Globals::esp_box_team;
      continue;
    }
    if (key == "esp_box_type_team") {
      in >> Globals::esp_box_type_team;
      continue;
    }
    if (key == "esp_skeleton_team") {
      in >> Globals::esp_skeleton_team;
      continue;
    }
    if (key == "esp_skeleton_type_team") {
      in >> Globals::esp_skeleton_type_team;
      continue;
    }
    if (key == "esp_head_team") {
      in >> Globals::esp_head_team;
      continue;
    }
    if (key == "esp_name_team") {
      in >> Globals::esp_name_team;
      continue;
    }
    if (key == "esp_distance_team") {
      in >> Globals::esp_distance_team;
      continue;
    }
    if (key == "esp_weapon_team") {
      in >> Globals::esp_weapon_team;
      continue;
    }
    if (key == "esp_health_team") {
      in >> Globals::esp_health_team;
      continue;
    }
    if (key == "esp_sound_enabled_team") {
      in >> Globals::esp_sound_enabled_team;
      continue;
    }
    if (key == "chams_enabled_team") {
      in >> Globals::chams_enabled_team;
      continue;
    }
    if (key == "chams_wireframe_team") {
      in >> Globals::chams_wireframe_team;
      continue;
    }
    if (key == "chams_filled_team") {
      in >> Globals::chams_filled_team;
      continue;
    }
    if (key == "chamsv2_enabled_team") {
      in >> Globals::chamsv2_enabled_team;
      continue;
    }
    if (key == "esp_box_color_team") {
      in >> Globals::esp_box_color_team[0] >> Globals::esp_box_color_team[1] >>
          Globals::esp_box_color_team[2] >> Globals::esp_box_color_team[3];
      continue;
    }
    if (key == "esp_box_color_vis_team") {
      in >> Globals::esp_box_color_vis_team[0] >>
          Globals::esp_box_color_vis_team[1] >>
          Globals::esp_box_color_vis_team[2] >>
          Globals::esp_box_color_vis_team[3];
      continue;
    }
    if (key == "esp_skeleton_color_team") {
      in >> Globals::esp_skeleton_color_team[0] >>
          Globals::esp_skeleton_color_team[1] >>
          Globals::esp_skeleton_color_team[2] >>
          Globals::esp_skeleton_color_team[3];
      continue;
    }
    if (key == "esp_skeleton_color_vis_team") {
      in >> Globals::esp_skeleton_color_vis_team[0] >>
          Globals::esp_skeleton_color_vis_team[1] >>
          Globals::esp_skeleton_color_vis_team[2] >>
          Globals::esp_skeleton_color_vis_team[3];
      continue;
    }
    if (key == "esp_name_color_team") {
      in >> Globals::esp_name_color_team[0] >>
          Globals::esp_name_color_team[1] >> Globals::esp_name_color_team[2] >>
          Globals::esp_name_color_team[3];
      continue;
    }
    if (key == "esp_name_color_vis_team") {
      in >> Globals::esp_name_color_vis_team[0] >>
          Globals::esp_name_color_vis_team[1] >>
          Globals::esp_name_color_vis_team[2] >>
          Globals::esp_name_color_vis_team[3];
      continue;
    }
    if (key == "esp_distance_color_team") {
      in >> Globals::esp_distance_color_team[0] >>
          Globals::esp_distance_color_team[1] >>
          Globals::esp_distance_color_team[2] >>
          Globals::esp_distance_color_team[3];
      continue;
    }
    if (key == "esp_distance_color_vis_team") {
      in >> Globals::esp_distance_color_vis_team[0] >>
          Globals::esp_distance_color_vis_team[1] >>
          Globals::esp_distance_color_vis_team[2] >>
          Globals::esp_distance_color_vis_team[3];
      continue;
    }
    if (key == "esp_health_color_team") {
      in >> Globals::esp_health_color_team[0] >>
          Globals::esp_health_color_team[1] >>
          Globals::esp_health_color_team[2] >>
          Globals::esp_health_color_team[3];
      continue;
    }
    if (key == "esp_health_color_vis_team") {
      in >> Globals::esp_health_color_vis_team[0] >>
          Globals::esp_health_color_vis_team[1] >>
          Globals::esp_health_color_vis_team[2] >>
          Globals::esp_health_color_vis_team[3];
      continue;
    }

    if (key == "esp_flags_enabled") { in >> Globals::esp_flags_enabled; continue; }
    if (key == "esp_flag_carrier")  { in >> Globals::esp_flag_carrier;  continue; }
    if (key == "esp_flag_money")    { in >> Globals::esp_flag_money;    continue; }
    if (key == "esp_flag_color_c4") {
      in >> Globals::esp_flag_color_c4[0] >> Globals::esp_flag_color_c4[1]
         >> Globals::esp_flag_color_c4[2] >> Globals::esp_flag_color_c4[3];
      continue;
    }
    if (key == "esp_flag_color_money") {
      in >> Globals::esp_flag_color_money[0] >> Globals::esp_flag_color_money[1]
         >> Globals::esp_flag_color_money[2] >> Globals::esp_flag_color_money[3];
      continue;
    }

    if (key == "esp_weapon_color_team") {
      in >> Globals::esp_weapon_color_team[0] >>
          Globals::esp_weapon_color_team[1] >>
          Globals::esp_weapon_color_team[2] >>
          Globals::esp_weapon_color_team[3];
      continue;
    }
    if (key == "esp_weapon_color_vis_team") {
      in >> Globals::esp_weapon_color_vis_team[0] >>
          Globals::esp_weapon_color_vis_team[1] >>
          Globals::esp_weapon_color_vis_team[2] >>
          Globals::esp_weapon_color_vis_team[3];
      continue;
    }
    if (key == "esp_sound_color_team") {
      in >> Globals::esp_sound_color_team[0] >>
          Globals::esp_sound_color_team[1] >>
          Globals::esp_sound_color_team[2] >> Globals::esp_sound_color_team[3];
      continue;
    }
    if (key == "chams_wire_color_team") {
      in >> Globals::chams_wire_color_team[0] >>
          Globals::chams_wire_color_team[1] >>
          Globals::chams_wire_color_team[2] >>
          Globals::chams_wire_color_team[3];
      continue;
    }
    if (key == "chams_wire_color_vis_team") {
      in >> Globals::chams_wire_color_vis_team[0] >>
          Globals::chams_wire_color_vis_team[1] >>
          Globals::chams_wire_color_vis_team[2] >>
          Globals::chams_wire_color_vis_team[3];
      continue;
    }
    if (key == "chams_fill_color_team") {
      in >> Globals::chams_fill_color_team[0] >>
          Globals::chams_fill_color_team[1] >>
          Globals::chams_fill_color_team[2] >>
          Globals::chams_fill_color_team[3];
      continue;
    }
    if (key == "chams_fill_color_vis_team") {
      in >> Globals::chams_fill_color_vis_team[0] >>
          Globals::chams_fill_color_vis_team[1] >>
          Globals::chams_fill_color_vis_team[2] >>
          Globals::chams_fill_color_vis_team[3];
      continue;
    }
    if (key == "chamsv2_fill_color_team") {
      in >> Globals::chamsv2_fill_color_team[0] >>
          Globals::chamsv2_fill_color_team[1] >>
          Globals::chamsv2_fill_color_team[2] >>
          Globals::chamsv2_fill_color_team[3];
      continue;
