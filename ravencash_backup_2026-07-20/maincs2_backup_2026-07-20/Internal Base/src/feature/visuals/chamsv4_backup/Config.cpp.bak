namespace {

void WriteDefaultConfigIfMissing(const std::filesystem::path &filePath,
                                 const char *content) {
  // Defaults are templates, not disposable files.  The previous code deleted
  // and recreated legit/rage every time GetConfigPath() was queried, which
  // made an apparently successful overwrite vanish on the next refresh.
  if (std::filesystem::exists(filePath))
    return;

  std::ofstream out(filePath);
  if (!out.is_open())
    return;

  out << content;
}

