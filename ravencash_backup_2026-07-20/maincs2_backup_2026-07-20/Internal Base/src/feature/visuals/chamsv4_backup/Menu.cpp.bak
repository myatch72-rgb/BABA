    {WEP_Ak47, "AK-47"},       {WEP_M4A4, "M4A4"},
    {WEP_M4A1S, "M4A1-S"},     {WEP_Awp, "AWP"},
    {WEP_Aug, "AUG"},          {WEP_Famas, "FAMAS"},
    {WEP_Galil, "Galil AR"},   {WEP_Sg556, "SG 553"},
    {WEP_Ssg08, "SSG 08"},     {WEP_Scar20, "SCAR-20"},
    {WEP_G3Sg1, "G3SG1"},
};

