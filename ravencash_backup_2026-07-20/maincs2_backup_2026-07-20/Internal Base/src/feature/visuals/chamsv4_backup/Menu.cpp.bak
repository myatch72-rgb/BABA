  int weaponIndex = 0;
  int knifeIndex = 0;
  int gloveIndex = 1;
  int agentTeam = 0;
  int selectedSkin = 0;
  int selectedAgent = 0;
  int rarityFilter = 0;
  float wear = 0.001f;
  int seed = 0;
  bool statTrak = false;
  int statTrakCount = 0;
  bool autoRotate = true;
  char search[96]{};
};

